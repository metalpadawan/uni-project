# ------------------------------------------------------------
# Secrets and environment configuration
# Keep sanitized templates such as .env.example in source control.
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.env
!*.env.example
secrets/
private/
credentials/
*.secret
*.secrets
*.credentials
*.token
*.tokens

# API keys, certificates, signing keys and authentication material
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.csr
*.pub
*.asc
*.gpg
*.kdbx
id_rsa*
id_ed25519*
service-account*.json
firebase-adminsdk*.json
google-credentials*.json

# ------------------------------------------------------------
# Sensitive biometric and student data
# Never commit raw faces, embeddings, identity exports or captures.
# ------------------------------------------------------------
uploads/
media/
storage/
private-media/
biometric-data/
biometrics/
face-data/
face-images/
face-samples/
face-captures/
face-embeddings/
embeddings/
enrolment-photos/
enrollment-photos/
camera-captures/
student-photos/
student-data/
attendance-exports/
exports/
reports/private/
*.embedding
*.embeddings
*.npy
*.npz
*.pickle
*.pkl

# Local image/video captures inside data or upload directories
**/uploads/**
**/biometrics/**
**/face-data/**
**/face-images/**
**/face-samples/**
**/face-captures/**
**/enrolment-photos/**
**/enrollment-photos/**
**/camera-captures/**

