# Docker Compose environment template. Copy this file to .env before running Docker Compose.
# Do not commit the resulting .env file.
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
QR_SIGNING_SECRET=replace-with-a-random-32-character-minimum-secret
JWT_SECRET=replace-with-a-different-random-32-character-minimum-secret
DEMO_MODE=false
FACE_DISTANCE_THRESHOLD=1.128
# Leave blank for local browser-only testing. For phone QR links, set the public
# deployment URL or your laptop's Wi-Fi address, e.g. http://192.168.1.25:5173.
PUBLIC_FRONTEND_URL=
# Add your public site URL or laptop Wi-Fi address here when a phone opens the
# frontend directly, e.g. http://192.168.1.25:5173.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
